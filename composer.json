{
    "name": "ghostwriter/coding-standard",
    "description": "PHP Coding Standard",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "ghostwriter",
        "coding-standard",
        "dev"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/coding-standard",
    "support": {
        "issues": "https://github.com/ghostwriter/coding-standard/issues",
        "forum": "https://github.com/ghostwriter/coding-standard/discussions",
        "source": "https://github.com/ghostwriter/coding-standard",
        "docs": "https://github.com/ghostwriter/coding-standard",
        "rss": "https://github.com/ghostwriter/coding-standard/releases.atom",
        "security": "https://github.com/ghostwriter/coding-standard/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-apcu": "*",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-ds": "*",
        "ext-event": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-gettext": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-memcached": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_pgsql": "*",
        "ext-pdo_sqlite": "*",
        "ext-pgsql": "*",
        "ext-phar": "*",
        "ext-protobuf": "*",
        "ext-readline": "*",
        "ext-redis": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "ext-sodium": "*",
        "ext-sqlite3": "*",
        "ext-tokenizer": "*",
        "ext-xdebug": "*",
        "ext-xml": "*",
        "ext-xmlreader": "*",
        "ext-xmlwriter": "*",
        "ext-xsl": "*",
        "ext-yaml": "*",
        "ext-zend-opcache": "*",
        "ext-zip": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.16.24",
        "ghostwriter/phpunit-assertions": "^0.1.1",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.3.1"
    },
    "conflict": {
        "pestphp/pest": "*"
    },
    "autoload": {
        "psr-4": {
            "Ghostwriter\\CodingStandard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\": "tests/Unit/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "thanks": {
            "name": "ghostwriter/coding-standard",
            "url": "https://github.com/ghostwriter/coding-standard"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "docker": [
            "@docker:build",
            "@docker:run"
        ],
        "docker:build": "docker buildx build --pull --tag workspace .",
        "docker:run": "docker run -v $(PWD):/github/workspace -w=/github/workspace -e GITHUB_DEBUG=1 -e GITHUB_WORKSPACE=/github/workspace -e GITHUB_TOKEN=github-token -e SIGNING_SECRET_KEY=secret-key workspace",
        "git:submodule:update": "git submodule update --depth=1 --init --recursive --recommend-shallow --remote",
        "infection": [
            "@xdebug",
            "infection --ansi --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "normalize": "composer-normalize --no-cache --diff --no-check-lock --no-scripts --no-plugins",
        "phive": [
            "phive update --force-accept-unsigned",
            "phive purge"
        ],
        "phive:install": "phive install --copy --force-accept-unsigned ",
        "phive:update": "phive update",
        "phpunit": [
            "@xdebug",
            "phpunit --do-not-cache-result --colors=always"
        ],
        "phpunit:migrate": [
            "@xdebug",
            "phpunit --do-not-cache-result --colors=always --migrate-configuration"
        ],
        "psalm": "psalm --no-cache --show-info=true --no-diff --shepherd --stats",
        "psalm:alter": "psalm --no-cache --alter --allow-backwards-incompatible-changes=false --safe-types",
        "psalm:baseline": "psalm --no-cache --no-diff --set-baseline=psalm-baseline.xml",
        "psalm:dry-run": "psalm --no-cache --alter --issues=all --dry-run",
        "psalm:fix": "psalm --no-cache --alter --issues=UnnecessaryVarAnnotation",
        "psalm:security": "psalm --no-cache --no-diff --taint-analysis",
        "psalm:update": "psalm --no-cache --no-diff --update-baseline=psalm-baseline.xml",
        "test": [
            "@phpunit",
            "@infection",
            "@psalm"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
